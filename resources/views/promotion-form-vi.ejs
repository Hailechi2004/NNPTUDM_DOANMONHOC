<%- include('partials/header-vi') %>

<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <a href="/promotions" class="text-blue-600 hover:underline flex items-center">
            <i class="fas fa-arrow-left mr-2"></i> Quay lại
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
        <h1 class="text-2xl font-bold text-gray-900 mb-8"><%= title %></h1>

        <form action="<%= action %>" method="GET" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Mã code</label>
                    <input type="text" name="code" value="<%= promotion.code || '' %>" required placeholder="Ví dụ: GIAMGIA10" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none font-mono uppercase">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Trạng thái</label>
                    <select name="status" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                        <option value="Active" <%= promotion.status === 'Active' ? 'selected' : '' %>>Hoạt động</option>
                        <option value="Expired" <%= promotion.status === 'Expired' ? 'selected' : '' %>>Hết hạn</option>
                        <option value="Disabled" <%= promotion.status === 'Disabled' ? 'selected' : '' %>>Vô hiệu hóa</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Loại giảm giá</label>
                    <select name="type" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                        <option value="Percentage" <%= promotion.type === 'Percentage' ? 'selected' : '' %>>Phần trăm (%)</option>
                        <option value="Fixed" <%= promotion.type === 'Fixed' ? 'selected' : '' %>>Số tiền cố định (đ)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Giá trị giảm</label>
                    <input type="text" name="discount" value="<%= promotion.discount || '' %>" required placeholder="Ví dụ: 20% hoặc 50000" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                </div>
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Mô tả khuyến mãi</label>
                <textarea name="description" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none"><%= promotion.description || '' %></textarea>
            </div>

            <div class="pt-4 flex space-x-4">
                <button type="submit" class="flex-1 bg-blue-600 text-white py-3 rounded-xl hover:bg-blue-700 transition font-bold">Lưu mã khuyến mãi</button>
                <a href="/promotions" class="flex-1 bg-gray-100 text-gray-700 py-3 rounded-xl hover:bg-gray-200 transition font-bold text-center">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer-vi') %>
