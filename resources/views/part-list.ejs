<%- include('partials/header-vi') %>

<div class="mb-8 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
    <div>
        <h1 class="text-3xl font-bold text-gray-900">Danh sách phụ tùng</h1>
        <p class="text-sm text-gray-500 mt-2">Lọc tồn kho và kiểm soát sản phẩm bằng dữ liệu thật.</p>
    </div>
    <a href="/parts/add" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition flex items-center">
        <i class="fas fa-plus mr-2"></i> Thêm phụ tùng mới
    </a>
</div>

<% if (errorMessage) { %>
    <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-red-700">
        <%= errorMessage %>
    </div>
<% } %>

<% if (successMessage) { %>
    <div class="mb-6 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-green-700">
        <%= successMessage %>
    </div>
<% } %>

<form action="/parts" method="GET" class="mb-8 bg-white rounded-2xl border border-gray-100 p-5 shadow-sm">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Tìm kiếm</label>
            <input type="text" name="search" value="<%= filters && filters.search ? filters.search : '' %>" placeholder="Tên, danh mục, nhà cung cấp" class="w-full px-4 py-3 border border-gray-300 rounded-xl outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Tồn kho</label>
            <select name="stock" class="w-full px-4 py-3 border border-gray-300 rounded-xl outline-none focus:ring-2 focus:ring-blue-500">
                <option value="all" <%= !filters || filters.stockFilter === 'all' ? 'selected' : '' %>>Tất cả</option>
                <option value="out" <%= filters && filters.stockFilter === 'out' ? 'selected' : '' %>>Hết hàng</option>
                <option value="low" <%= filters && filters.stockFilter === 'low' ? 'selected' : '' %>>Sắp hết hàng</option>
                <option value="available" <%= filters && filters.stockFilter === 'available' ? 'selected' : '' %>>Còn hàng</option>
                <option value="high" <%= filters && filters.stockFilter === 'high' ? 'selected' : '' %>>Còn nhiều</option>
            </select>
        </div>
        <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Sắp xếp</label>
            <select name="sort" class="w-full px-4 py-3 border border-gray-300 rounded-xl outline-none focus:ring-2 focus:ring-blue-500">
                <option value="newest" <%= !filters || filters.sort === 'newest' ? 'selected' : '' %>>Mới nhất</option>
                <option value="price-asc" <%= filters && filters.sort === 'price-asc' ? 'selected' : '' %>>Giá thấp đến cao</option>
                <option value="price-desc" <%= filters && filters.sort === 'price-desc' ? 'selected' : '' %>>Giá cao đến thấp</option>
                <option value="stock-desc" <%= filters && filters.sort === 'stock-desc' ? 'selected' : '' %>>Tồn kho nhiều nhất</option>
            </select>
        </div>
        <div class="flex items-end gap-3">
            <button type="submit" class="flex-1 bg-blue-600 text-white px-4 py-3 rounded-xl font-bold hover:bg-blue-700 transition">Lọc</button>
            <a href="/parts" class="px-4 py-3 rounded-xl bg-gray-100 text-gray-700 font-bold hover:bg-gray-200 transition">Đặt lại</a>
        </div>
    </div>
</form>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <% parts.forEach(part => { %>
        <div class="bg-white rounded-xl shadow-sm border overflow-hidden hover:shadow-lg transition group">
            <a href="/parts/detail/<%= part.id %>" class="block">
                <div class="relative overflow-hidden">
                    <img src="<%= part.image %>" alt="<%= part.name %>" class="w-full h-48 object-cover group-hover:scale-105 transition duration-300">
                    <div class="absolute top-2 right-2 flex flex-col gap-2 items-end">
                        <span class="px-2 py-1 bg-white/90 backdrop-blur-sm text-xs font-bold rounded-md shadow-sm <%= part.stock > 5 ? 'text-green-600' : part.stock > 0 ? 'text-amber-600' : 'text-red-600' %>">
                            <%= part.stock > 0 ? 'Kho: ' + part.stock : 'Hết hàng' %>
                        </span>
                        <% if (part.showPromotion) { %>
                            <span class="px-2 py-1 bg-red-600 text-white text-xs font-bold rounded-md shadow-sm">
                                -<%= part.discountPercent %>%
                            </span>
                        <% } %>
                    </div>
                </div>
            </a>
            <div class="p-4">
                <span class="text-xs font-semibold text-blue-600 uppercase tracking-wider"><%= part.category %></span>
                <a href="/parts/detail/<%= part.id %>" class="block">
                    <h2 class="text-lg font-bold text-gray-900 mt-1 hover:text-blue-600 transition truncate"><%= part.name %></h2>
                </a>
                <div class="flex flex-col mt-4">
                    <% if (part.showPromotion) { %>
                        <span class="text-sm text-gray-400 line-through"><%= part.originalPrice.toLocaleString('vi-VN') %> đ</span>
                    <% } %>
                    <span class="text-xl font-bold text-red-600"><%= part.finalPrice.toLocaleString('vi-VN') %> đ</span>
                </div>
                <div class="mt-4 flex space-x-2">
                    <a href="/parts/edit/<%= part.id %>" class="flex-1 bg-gray-100 text-gray-700 py-2 rounded-md hover:bg-blue-50 hover:text-blue-600 transition text-sm font-medium text-center">
                        <i class="fas fa-edit mr-1"></i> Sửa
                    </a>
                    <a href="/parts/delete/<%= part.id %>" onclick="return confirm('Bạn có chắc chắn muốn xóa phụ tùng này?')" class="flex-1 bg-red-50 text-red-600 py-2 rounded-md hover:bg-red-600 hover:text-white transition text-sm font-medium text-center">
                        <i class="fas fa-trash-alt mr-1"></i> Xóa
                    </a>
                </div>
            </div>
        </div>
    <% }) %>
</div>

<%- include('partials/footer-vi') %>
