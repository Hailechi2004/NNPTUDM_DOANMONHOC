<%- include('partials/header') %>

<div class="mb-8 flex justify-between items-center">
    <h1 class="text-3xl font-bold text-gray-900">Danh sách phụ tùng</h1>
    <a href="/parts/add" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition flex items-center">
        <i class="fas fa-plus mr-2"></i> Thêm phụ tùng mới
    </a>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <% parts.forEach(part => { %>
        <div class="bg-white rounded-xl shadow-sm border overflow-hidden hover:shadow-lg transition group">
            <a href="/parts/detail/<%= part.id %>" class="block">
                <div class="relative overflow-hidden">
                    <img src="<%= part.image %>" alt="<%= part.name %>" class="w-full h-48 object-cover group-hover:scale-105 transition duration-300">
                    <div class="absolute top-2 right-2">
                        <span class="px-2 py-1 bg-white/90 backdrop-blur-sm text-xs font-bold rounded-md shadow-sm <%= part.stock > 10 ? 'text-green-600' : 'text-red-600' %>">
                            Kho: <%= part.stock %>
                        </span>
                    </div>
                </div>
            </a>
            <div class="p-4">
                <span class="text-xs font-semibold text-blue-600 uppercase tracking-wider"><%= part.category %></span>
                <a href="/parts/detail/<%= part.id %>" class="block">
                    <h2 class="text-lg font-bold text-gray-900 mt-1 hover:text-blue-600 transition truncate"><%= part.name %></h2>
                </a>
                <div class="flex flex-col mt-4">
                    <% if (part.hasPromotion && part.discountPrice) { %>
                        <span class="text-sm text-gray-400 line-through"><%= part.price.toLocaleString('vi-VN') %> đ</span>
                        <span class="text-xl font-bold text-red-600"><%= part.discountPrice.toLocaleString('vi-VN') %> đ</span>
                    <% } else { %>
                        <span class="text-xl font-bold text-red-600"><%= part.price.toLocaleString('vi-VN') %> đ</span>
                    <% } %>
                </div>
                <div class="mt-4 flex space-x-2">
                    <a href="/parts/edit/<%= part.id %>" class="flex-1 bg-gray-100 text-gray-700 py-2 rounded-md hover:bg-blue-50 hover:text-blue-600 transition text-sm font-medium text-center">
                        <i class="fas fa-edit mr-1"></i> Sửa
                    </a>
                    <a href="/parts/delete/<%= part.id %>" onclick="return confirm('Bạn có chắc chắn muốn xóa phụ tùng này?')" class="flex-1 bg-red-50 text-red-600 py-2 rounded-md hover:bg-red-600 hover:text-white transition text-sm font-medium text-center">
                        <i class="fas fa-trash-alt mr-1"></i> Xóa
                    </a>
                </div>
            </div>
        </div>
    <% }) %>
</div>

<%- include('partials/footer') %>
