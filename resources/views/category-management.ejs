<%- include('partials/header-vi') %>

<div class="bg-white shadow-sm border rounded-xl overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center">
        <h3 class="font-bold text-gray-900">Danh mục phụ tùng</h3>
        <a href="/categories/add" class="bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-blue-700 transition">
            <i class="fas fa-plus mr-2"></i> Thêm danh mục mới
        </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-6">
        <% categories.forEach(cat => { %>
            <div class="border rounded-xl p-4 hover:shadow-md transition bg-white group">
                <div class="flex justify-between items-start mb-4">
                    <div class="p-3 bg-blue-50 text-blue-600 rounded-lg group-hover:bg-blue-600 group-hover:text-white transition duration-300">
                        <i class="fas fa-folder text-xl"></i>
                    </div>
                    <span class="text-xs font-bold text-gray-400 bg-gray-50 px-2 py-1 rounded"><%= cat.count %> sản phẩm</span>
                </div>
                <h4 class="font-bold text-gray-900 mb-1 text-lg"><%= cat.name %></h4>
                <p class="text-sm text-gray-500 mb-4 h-10 overflow-hidden"><%= cat.description %></p>
                <div class="flex space-x-3 pt-4 border-t border-gray-50">
                    <a href="/categories/edit/<%= cat.id %>" class="text-sm text-blue-600 font-bold hover:text-blue-800 flex items-center">
                        <i class="fas fa-edit mr-1"></i> Sửa
                    </a>
                    <a href="/categories/delete/<%= cat.id %>" onclick="return confirm('Xóa danh mục này?')" class="text-sm text-red-600 font-bold hover:text-red-800 flex items-center">
                        <i class="fas fa-trash-alt mr-1"></i> Xóa
                    </a>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<%- include('partials/footer-vi') %>
