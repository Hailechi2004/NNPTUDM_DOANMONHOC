<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cửa hàng Phụ tùng Ô tô | Customer View</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-50">
    <!-- Admin Preview Banner -->
    <div class="bg-yellow-400 text-yellow-900 py-2 text-center text-sm font-bold shadow-sm">
        <i class="fas fa-eye mr-2"></i> CHẾ ĐỘ XEM TRƯỚC (CUSTOMER VIEW) - <a href="/" class="underline">Quay lại Admin</a>
    </div>

    <!-- Customer Navbar -->
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20 items-center">
                <div class="flex items-center">
                    <span class="text-2xl font-black text-blue-600 tracking-tighter">HUTECH<span class="text-gray-900">PARTS</span></span>
                </div>
                <div class="hidden md:flex space-x-8 font-medium text-gray-600">
                    <a href="#" class="hover:text-blue-600 transition">Trang chủ</a>
                    <a href="#" class="text-blue-600 font-bold">Cửa hàng</a>
                    <a href="#" class="hover:text-blue-600 transition">Dịch vụ</a>
                    <a href="#" class="hover:text-blue-600 transition">Liên hệ</a>
                </div>
                <div class="flex items-center space-x-5">
                    <button class="text-gray-600 hover:text-blue-600 transition relative">
                        <i class="fas fa-shopping-cart text-xl"></i>
                        <span class="absolute -top-2 -right-2 bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full">3</span>
                    </button>
                    <button class="bg-blue-600 text-white px-5 py-2.5 rounded-full font-bold hover:bg-blue-700 transition shadow-lg shadow-blue-200">
                        Đăng nhập
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="bg-blue-600 py-16 text-white overflow-hidden relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <h1 class="text-5xl font-black mb-4 leading-tight">Phụ tùng chính hãng<br>Nâng tầm xế yêu</h1>
            <p class="text-xl text-blue-100 mb-8 max-w-2xl">Hơn 10,000+ phụ tùng ô tô chất lượng cao từ các thương hiệu hàng đầu thế giới. Giao hàng nhanh toàn quốc.</p>
            <div class="flex space-x-4">
                <button class="bg-white text-blue-600 px-8 py-4 rounded-xl font-black hover:bg-gray-100 transition shadow-xl">Mua ngay</button>
                <button class="border-2 border-white/30 backdrop-blur-sm px-8 py-4 rounded-xl font-black hover:bg-white/10 transition">Tìm hiểu thêm</button>
            </div>
        </div>
        <div class="absolute top-0 right-0 w-1/3 h-full bg-white/10 skew-x-12 transform translate-x-20"></div>
    </header>

    <!-- Shop Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="flex flex-col md:flex-row gap-8">
            <!-- Sidebar Filters -->
            <aside class="w-full md:w-64 flex-shrink-0">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 sticky top-24">
                    <h3 class="font-black text-gray-900 mb-6 uppercase tracking-widest text-sm">Danh mục</h3>
                    <div class="space-y-3">
                        <label class="flex items-center group cursor-pointer">
                            <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            <span class="ml-3 text-gray-600 group-hover:text-blue-600 transition">Lốp xe</span>
                        </label>
                        <label class="flex items-center group cursor-pointer">
                            <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            <span class="ml-3 text-gray-600 group-hover:text-blue-600 transition">Đèn pha</span>
                        </label>
                        <label class="flex items-center group cursor-pointer">
                            <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            <span class="ml-3 text-gray-600 group-hover:text-blue-600 transition">Bugi</span>
                        </label>
                        <label class="flex items-center group cursor-pointer">
                            <input type="checkbox" class="w-5 h-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                            <span class="ml-3 text-gray-600 group-hover:text-blue-600 transition">Dầu nhớt</span>
                        </label>
                    </div>

                    <h3 class="font-black text-gray-900 mt-10 mb-6 uppercase tracking-widest text-sm">Khoảng giá</h3>
                    <input type="range" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-blue-600">
                    <div class="flex justify-between mt-2 text-xs font-bold text-gray-400">
                        <span>0đ</span>
                        <span>10M+</span>
                    </div>
                </div>
            </aside>

            <!-- Product Grid -->
            <div class="flex-1">
                <div class="flex justify-between items-center mb-8">
                    <p class="text-gray-500 font-medium">Hiển thị <span class="text-gray-900 font-bold">6</span> sản phẩm</p>
                    <select class="bg-white border border-gray-200 px-4 py-2 rounded-xl text-sm font-bold outline-none focus:ring-2 focus:ring-blue-500">
                        <option>Mới nhất</option>
                        <option>Giá thấp đến cao</option>
                        <option>Giá cao đến thấp</option>
                    </select>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                    <% parts.forEach(part => { %>
                        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-2xl hover:-translate-y-2 transition duration-500 group">
                            <div class="relative h-64 overflow-hidden bg-gray-50">
                                <img src="<%= part.image %>" alt="<%= part.name %>" class="w-full h-full object-cover group-hover:scale-110 transition duration-700">
                                <div class="absolute top-4 left-4">
                                    <% if (part.hasPromotion) { %>
                                        <span class="bg-red-600 text-white text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-widest">Sale</span>
                                    <% } else { %>
                                        <span class="bg-blue-600 text-white text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-widest">Hot</span>
                                    <% } %>
                                </div>
                                <button class="absolute bottom-4 right-4 bg-white/90 backdrop-blur-md p-3 rounded-2xl shadow-xl text-gray-900 hover:bg-blue-600 hover:text-white transition duration-300 opacity-0 group-hover:opacity-100 translate-y-4 group-hover:translate-y-0">
                                    <i class="fas fa-shopping-cart"></i>
                                </button>
                            </div>
                            <div class="p-6">
                                <p class="text-[10px] font-black text-blue-600 uppercase tracking-widest mb-1"><%= part.category %></p>
                                <h3 class="text-lg font-black text-gray-900 mb-2 group-hover:text-blue-600 transition"><%= part.name %></h3>
                                <div class="flex items-center mb-4">
                                    <div class="flex text-yellow-400 text-xs mr-2">
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star-half-alt"></i>
                                    </div>
                                    <span class="text-xs text-gray-400 font-bold">(12 đánh giá)</span>
                                </div>
                                <div class="flex justify-between items-center pt-4 border-t border-gray-50">
                                    <div class="flex flex-col">
                                        <% if (part.hasPromotion && part.discountPrice) { %>
                                            <span class="text-xs text-gray-400 line-through font-bold"><%= part.price.toLocaleString('vi-VN') %> đ</span>
                                            <span class="text-xl font-black text-red-600"><%= part.discountPrice.toLocaleString('vi-VN') %> đ</span>
                                        <% } else { %>
                                            <span class="text-xl font-black text-gray-900"><%= part.price.toLocaleString('vi-VN') %> đ</span>
                                        <% } %>
                                    </div>
                                    <button class="text-blue-600 font-black text-xs hover:underline">CHI TIẾT</button>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </main>

    <footer class="bg-gray-900 text-white py-20 mt-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <span class="text-3xl font-black text-blue-500 tracking-tighter mb-8 block">HUTECH<span class="text-white">PARTS</span></span>
            <p class="text-gray-500 max-w-xl mx-auto mb-10">Chuyên cung cấp phụ tùng ô tô chính hãng, uy tín hàng đầu Việt Nam. Đồng hành cùng bạn trên mọi nẻo đường.</p>
            <div class="flex justify-center space-x-6 mb-12">
                <a href="#" class="w-12 h-12 bg-white/5 rounded-full flex items-center justify-center hover:bg-blue-600 transition"><i class="fab fa-facebook-f"></i></a>
                <a href="#" class="w-12 h-12 bg-white/5 rounded-full flex items-center justify-center hover:bg-blue-600 transition"><i class="fab fa-instagram"></i></a>
                <a href="#" class="w-12 h-12 bg-white/5 rounded-full flex items-center justify-center hover:bg-blue-600 transition"><i class="fab fa-youtube"></i></a>
            </div>
            <p class="text-gray-600 text-sm">&copy; 2024 HUTECH Parts. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>
