<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-slate-50 text-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex items-center justify-between gap-4 mb-8">
            <a href="/" class="inline-flex items-center text-blue-700 font-bold hover:underline">
                <i class="fas fa-arrow-left mr-2"></i>Tiếp tục mua sắm
            </a>
            <a href="/shop/orders" class="inline-flex items-center rounded-full border border-slate-200 px-4 py-2 font-bold text-slate-700 hover:border-blue-500 hover:text-blue-700 transition">
                Đơn hàng của tôi
            </a>
        </div>

        <% if (successMessage) { %>
            <div class="mb-6 rounded-2xl border border-green-200 bg-green-50 px-5 py-4 text-green-700 font-semibold"><%= successMessage %></div>
        <% } %>
        <% if (errorMessage) { %>
            <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-red-700 font-semibold"><%= errorMessage %></div>
        <% } %>

        <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_360px] gap-8">
            <section class="space-y-5">
                <% if (cart.items.length === 0) { %>
                    <div class="bg-white rounded-[28px] border border-dashed border-slate-300 p-10 text-center text-slate-500">
                        Giỏ hàng của bạn đang trống.
                    </div>
                <% } else { %>
                    <% cart.items.forEach(item => { %>
                        <article class="bg-white rounded-[28px] border border-slate-200 p-5 shadow-sm">
                            <div class="grid grid-cols-1 md:grid-cols-[120px_minmax(0,1fr)_160px] gap-5 items-center">
                                <img src="<%= item.image %>" alt="<%= item.name %>" class="w-full h-28 rounded-2xl object-cover bg-slate-100">

                                <div>
                                    <p class="text-xs font-black uppercase tracking-[0.25em] text-blue-700 mb-2"><%= item.category %></p>
                                    <h3 class="text-xl font-black text-slate-900"><%= item.name %></h3>
                                    <p class="text-sm text-slate-500 mt-2">Tồn kho hiện tại: <span class="font-bold"><%= item.stock %></span></p>
                                    <% if (item.appliedPromotionCode) { %>
                                        <p class="mt-2 inline-flex rounded-full bg-green-100 px-3 py-1 text-xs font-black text-green-700">
                                            Đã áp mã: <%= item.appliedPromotionCode %>
                                        </p>
                                    <% } else if (item.canApplyPromotion) { %>
                                        <p class="mt-2 text-xs font-semibold text-amber-700">
                                            Sản phẩm này có thể áp mã khuyến mãi nếu nhập đúng mã đã được admin gán.
                                        </p>
                                    <% } %>
                                    <div class="mt-3">
                                        <% if (item.showPromotion) { %>
                                            <p class="text-sm text-slate-400 line-through"><%= item.originalPrice.toLocaleString('vi-VN') %> đ</p>
                                        <% } %>
                                        <p class="text-lg font-black text-slate-900"><%= item.finalPrice.toLocaleString('vi-VN') %> đ</p>
                                        <% if (item.appliedPromotionCode && item.discountAmount > 0) { %>
                                            <p class="mt-2 text-sm font-semibold text-green-700">
                                                Mã <%= item.appliedPromotionCode %> đã giảm thêm <%= item.discountAmount.toLocaleString('vi-VN') %> đ
                                            </p>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="space-y-3">
                                    <form action="/shop/cart/update/<%= item.partId %>" method="POST">
                                        <label class="text-xs font-bold uppercase text-slate-500 block mb-2">Số lượng</label>
                                        <input type="number" name="quantity" min="1" max="<%= item.stock %>" value="<%= item.quantity %>" class="w-full rounded-2xl border border-slate-200 px-4 py-3 font-bold outline-none focus:border-blue-500">
                                        <button type="submit" class="w-full mt-3 rounded-2xl bg-blue-700 px-4 py-3 font-bold text-white hover:bg-blue-800 transition">Cập nhật</button>
                                    </form>

                                    <form action="/shop/cart/remove/<%= item.partId %>" method="POST">
                                        <button type="submit" class="w-full rounded-2xl bg-red-50 px-4 py-3 font-bold text-red-600 hover:bg-red-600 hover:text-white transition">Xóa khỏi giỏ</button>
                                    </form>

                                    <% if (item.canApplyPromotion) { %>
                                        <form action="/shop/cart/apply-code/<%= item.partId %>" method="POST">
                                            <input type="text" name="promoCode" placeholder="Nhập mã giảm giá" class="w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-semibold outline-none focus:border-blue-500">
                                            <button type="submit" class="w-full mt-3 rounded-2xl bg-amber-500 px-4 py-3 font-bold text-white hover:bg-amber-600 transition">Áp mã</button>
                                        </form>
                                        <% if (item.appliedPromotionCode) { %>
                                            <form action="/shop/cart/clear-code/<%= item.partId %>" method="POST">
                                                <button type="submit" class="w-full rounded-2xl bg-slate-100 px-4 py-3 font-bold text-slate-700 hover:bg-slate-200 transition">Gỡ mã</button>
                                            </form>
                                        <% } %>
                                    <% } %>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                <% } %>
            </section>

            <aside class="bg-white rounded-[28px] border border-slate-200 p-6 shadow-sm h-fit">
                <h2 class="text-2xl font-black text-slate-900 mb-6">Thanh toán</h2>

                <div class="space-y-3 text-slate-600">
                    <div class="flex items-center justify-between">
                        <span>Tổng số sản phẩm</span>
                        <span class="font-black text-slate-900"><%= cart.cartCount %></span>
                    </div>
                    <div class="flex items-center justify-between text-lg">
                        <span>Tạm tính</span>
                        <span class="font-black text-slate-900"><%= cart.totalAmount.toLocaleString('vi-VN') %> đ</span>
                    </div>
                </div>

                <form action="/shop/checkout" method="POST" class="mt-6 space-y-4">
                    <div>
                        <label class="text-sm font-bold text-slate-700 block mb-2">Địa chỉ giao hàng</label>
                        <textarea name="shippingAddress" rows="4" class="w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none focus:border-blue-500"><%= cart.customer.address || '' %></textarea>
                    </div>
                    <button type="submit" <%= cart.items.length === 0 ? 'disabled' : '' %> class="w-full rounded-2xl bg-blue-700 px-5 py-3 font-black text-white hover:bg-blue-800 transition disabled:cursor-not-allowed disabled:bg-slate-300">
                        Đặt hàng ngay
                    </button>
                </form>
            </aside>
        </div>
    </div>
</body>
</html>
