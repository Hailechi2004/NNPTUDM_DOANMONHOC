<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gray-100">
    <div class="min-h-screen flex">
        <!-- Sidebar -->
        <aside class="w-64 bg-slate-900 text-white flex-shrink-0 hidden md:flex flex-col">
            <div class="p-6 border-b border-slate-800">
                <a href="/" class="flex items-center space-x-3">
                    <i class="fas fa-car-side text-2xl text-blue-400"></i>
                    <span class="text-xl font-bold tracking-wider">TUNGNT ADMIN</span>
                </a>
            </div>
            <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2 px-2">Chính</p>
                <a href="/" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition <%= title === 'Dashboard' ? 'bg-blue-600 text-white' : 'text-slate-400' %>">
                    <i class="fas fa-chart-line w-5"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/shop-preview" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition <%= title === 'Shop Preview' ? 'bg-blue-600 text-white' : 'text-slate-400' %>">
                    <i class="fas fa-eye w-5"></i>
                    <span>Xem trước Shop</span>
                </a>
                
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-6 mb-2 px-2">Quản lý kho</p>
                <a href="/parts" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition <%= title === 'Danh sách phụ tùng' ? 'bg-blue-600 text-white' : 'text-slate-400' %>">
                    <i class="fas fa-tools w-5"></i>
                    <span>Phụ tùng</span>
                </a>
                <a href="/categories" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition <%= title === 'Danh mục' ? 'bg-blue-600 text-white' : 'text-slate-400' %>">
                    <i class="fas fa-tags w-5"></i>
                    <span>Danh mục</span>
                </a>
                <a href="/suppliers" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition <%= title === 'Nhà cung cấp' ? 'bg-blue-600 text-white' : 'text-slate-400' %>">
                    <i class="fas fa-truck w-5"></i>
                    <span>Nhà cung cấp</span>
                </a>

                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-6 mb-2 px-2">Giao dịch</p>
                <a href="/orders" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition <%= title === 'Quản lý đơn hàng' ? 'bg-blue-600 text-white' : 'text-slate-400' %>">
                    <i class="fas fa-shopping-cart w-5"></i>
                    <span>Đơn hàng</span>
                </a>
                <a href="/promotions" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition <%= title === 'Khuyến mãi' ? 'bg-blue-600 text-white' : 'text-slate-400' %>">
                    <i class="fas fa-percentage w-5"></i>
                    <span>Khuyến mãi</span>
                </a>

                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-6 mb-2 px-2">Hệ thống</p>
                <a href="/users" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition <%= title === 'Người dùng' ? 'bg-blue-600 text-white' : 'text-slate-400' %>">
                    <i class="fas fa-users w-5"></i>
                    <span>Người dùng</span>
                </a>
                <a href="#" class="flex items-center space-x-3 px-4 py-3 rounded-lg hover:bg-slate-800 transition text-slate-400">
                    <i class="fas fa-cog w-5"></i>
                    <span>Cài đặt</span>
                </a>
            </nav>
            <div class="p-4 border-t border-slate-800">
                <div class="flex items-center space-x-3 px-4 py-2">
                    <div class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center font-bold"><%= authUser && authUser.fullName ? authUser.fullName.charAt(0) : 'A' %></div>
                    <div class="overflow-hidden">
                        <p class="text-sm font-medium truncate"><%= authUser && authUser.fullName ? authUser.fullName : 'Admin HUTECH' %></p>
                        <p class="text-xs text-slate-500 truncate"><%= authUser && authUser.email ? authUser.email : 'hailechi97@gmail.com' %></p>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
            <!-- Top Header -->
            <header class="bg-white shadow-sm z-10">
                <div class="px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                    <div class="flex items-center">
                        <button class="md:hidden p-2 text-gray-600 hover:bg-gray-100 rounded-lg mr-2">
                            <i class="fas fa-bars"></i>
                        </button>
                        <h2 class="text-xl font-semibold text-gray-800"><%= title %></h2>
                    </div>
                    <div class="flex items-center space-x-4">
                        <div class="relative hidden sm:block">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                                <i class="fas fa-search"></i>
                            </span>
                            <input type="text" class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md leading-5 bg-gray-50 placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-blue-500 sm:text-sm" placeholder="Tìm kiếm...">
                        </div>
                        <button class="p-2 text-gray-400 hover:text-gray-600 relative">
                            <i class="fas fa-bell"></i>
                            <span class="absolute top-2 right-2 block h-2 w-2 rounded-full bg-red-500 ring-2 ring-white"></span>
                        </button>
                        <form action="/auth/logout" method="POST">
                            <button class="p-2 text-gray-400 hover:text-gray-600" type="submit">
                                <i class="fas fa-sign-out-alt"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </header>

            <!-- Content Area -->
            <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
