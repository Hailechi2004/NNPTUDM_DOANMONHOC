<%- include('partials/header') %>

<!-- Stats Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center">
        <div class="p-3 rounded-lg bg-blue-50 text-blue-600 mr-4">
            <i class="fas fa-shopping-bag text-2xl"></i>
        </div>
        <div>
            <p class="text-sm text-gray-500 font-medium">Tổng đơn hàng</p>
            <h3 class="text-2xl font-bold text-gray-900">1,284</h3>
            <p class="text-xs text-green-600 mt-1"><i class="fas fa-arrow-up mr-1"></i> 12% so với tháng trước</p>
        </div>
    </div>
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center">
        <div class="p-3 rounded-lg bg-green-50 text-green-600 mr-4">
            <i class="fas fa-dollar-sign text-2xl"></i>
        </div>
        <div>
            <p class="text-sm text-gray-500 font-medium">Doanh thu</p>
            <h3 class="text-2xl font-bold text-gray-900">452.8M đ</h3>
            <p class="text-xs text-green-600 mt-1"><i class="fas fa-arrow-up mr-1"></i> 8% so với tháng trước</p>
        </div>
    </div>
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center">
        <div class="p-3 rounded-lg bg-purple-50 text-purple-600 mr-4">
            <i class="fas fa-tools text-2xl"></i>
        </div>
        <div>
            <p class="text-sm text-gray-500 font-medium">Sản phẩm trong kho</p>
            <h3 class="text-2xl font-bold text-gray-900">856</h3>
            <p class="text-xs text-red-600 mt-1"><i class="fas fa-arrow-down mr-1"></i> 3% sản phẩm sắp hết</p>
        </div>
    </div>
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center">
        <div class="p-3 rounded-lg bg-yellow-50 text-yellow-600 mr-4">
            <i class="fas fa-users text-2xl"></i>
        </div>
        <div>
            <p class="text-sm text-gray-500 font-medium">Khách hàng mới</p>
            <h3 class="text-2xl font-bold text-gray-900">124</h3>
            <p class="text-xs text-green-600 mt-1"><i class="fas fa-arrow-up mr-1"></i> 15% so với tuần trước</p>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <!-- Recent Orders Table -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center">
            <h3 class="font-bold text-gray-900">Đơn hàng gần đây</h3>
            <a href="/orders" class="text-sm text-blue-600 hover:underline">Xem tất cả</a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead class="bg-gray-50 text-xs uppercase text-gray-500 font-semibold">
                    <tr>
                        <th class="px-6 py-3">Mã đơn</th>
                        <th class="px-6 py-3">Khách hàng</th>
                        <th class="px-6 py-3">Trạng thái</th>
                        <th class="px-6 py-3">Tổng</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    <tr>
                        <td class="px-6 py-4 text-sm font-medium text-blue-600">#ORD-9482</td>
                        <td class="px-6 py-4 text-sm text-gray-600">Nguyễn Văn A</td>
                        <td class="px-6 py-4 text-sm">
                            <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium">Đã giao</span>
                        </td>
                        <td class="px-6 py-4 text-sm font-bold text-gray-900">1.2M đ</td>
                    </tr>
                    <tr>
                        <td class="px-6 py-4 text-sm font-medium text-blue-600">#ORD-9481</td>
                        <td class="px-6 py-4 text-sm text-gray-600">Trần Thị B</td>
                        <td class="px-6 py-4 text-sm">
                            <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded-full text-xs font-medium">Đang xử lý</span>
                        </td>
                        <td class="px-6 py-4 text-sm font-bold text-gray-900">850K đ</td>
                    </tr>
                    <tr>
                        <td class="px-6 py-4 text-sm font-medium text-blue-600">#ORD-9480</td>
                        <td class="px-6 py-4 text-sm text-gray-600">Lê Văn C</td>
                        <td class="px-6 py-4 text-sm">
                            <span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-medium">Chờ duyệt</span>
                        </td>
                        <td class="px-6 py-4 text-sm font-bold text-gray-900">2.4M đ</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Top Selling Products -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center">
            <h3 class="font-bold text-gray-900">Sản phẩm bán chạy</h3>
            <a href="/parts" class="text-sm text-blue-600 hover:underline">Xem kho</a>
        </div>
        <div class="p-6 space-y-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <img src="https://picsum.photos/seed/tire/40/40" class="w-10 h-10 rounded-lg mr-3">
                    <div>
                        <p class="text-sm font-bold text-gray-900">Lốp Michelin PS4</p>
                        <p class="text-xs text-gray-500">Danh mục: Lốp xe</p>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-sm font-bold text-gray-900">42 lượt bán</p>
                    <p class="text-xs text-green-600">+12%</p>
                </div>
            </div>
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <img src="https://picsum.photos/seed/spark/40/40" class="w-10 h-10 rounded-lg mr-3">
                    <div>
                        <p class="text-sm font-bold text-gray-900">Bugi NGK Iridium</p>
                        <p class="text-xs text-gray-500">Danh mục: Bugi</p>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-sm font-bold text-gray-900">38 lượt bán</p>
                    <p class="text-xs text-green-600">+5%</p>
                </div>
            </div>
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <img src="https://picsum.photos/seed/oil/40/40" class="w-10 h-10 rounded-lg mr-3">
                    <div>
                        <p class="text-sm font-bold text-gray-900">Dầu Castrol Edge</p>
                        <p class="text-xs text-gray-500">Danh mục: Dầu nhớt</p>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-sm font-bold text-gray-900">25 lượt bán</p>
                    <p class="text-xs text-red-600">-2%</p>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
