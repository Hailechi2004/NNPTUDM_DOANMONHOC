<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-slate-50 text-slate-900">
    <% const authUser = locals.authUser || null; %>
    <% const isCustomer = authUser && authUser.role === 'Customer'; %>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="mb-6 flex items-center justify-between gap-4">
            <a href="/" class="inline-flex items-center text-blue-700 font-bold hover:underline">
                <i class="fas fa-arrow-left mr-2"></i>Quay lại cửa hàng
            </a>
            <a href="/shop/cart" class="inline-flex items-center rounded-full border border-slate-200 px-4 py-2 font-bold text-slate-700 hover:border-blue-500 hover:text-blue-700 transition">
                <i class="fas fa-shopping-cart mr-2"></i>Giỏ hàng (<%= cartCount || 0 %>)
            </a>
        </div>

        <div class="bg-white rounded-[32px] border border-slate-200 shadow-sm overflow-hidden">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
                <div class="bg-slate-100 p-6 lg:p-10">
                    <img src="<%= part.image %>" alt="<%= part.name %>" class="w-full h-[420px] object-cover rounded-[24px]">
                </div>

                <div class="p-8 lg:p-10 flex flex-col">
                    <p class="text-xs font-black uppercase tracking-[0.3em] text-blue-700 mb-3"><%= part.category %></p>
                    <h1 class="text-4xl font-black text-slate-900 mb-4"><%= part.name %></h1>
                    <p class="text-slate-600 leading-8 mb-6"><%= part.description || 'Phụ tùng chính hãng, phù hợp cho nhu cầu thay thế và bảo dưỡng xe.' %></p>

                    <div class="rounded-3xl bg-slate-50 border border-slate-200 p-6 mb-6">
                        <% if (part.showPromotion) { %>
                            <p class="text-sm text-slate-400 line-through"><%= part.originalPrice.toLocaleString('vi-VN') %> đ</p>
                            <div class="flex items-center gap-4 mt-1">
                                <p class="text-4xl font-black text-red-600"><%= part.finalPrice.toLocaleString('vi-VN') %> đ</p>
                                <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-black text-red-600">-<%= part.discountPercent %>%</span>
                            </div>
                        <% } else { %>
                            <p class="text-4xl font-black text-slate-900"><%= part.finalPrice.toLocaleString('vi-VN') %> đ</p>
                        <% } %>
                    </div>

                    <div class="grid grid-cols-2 gap-4 mb-8">
                        <div class="rounded-2xl bg-slate-50 border border-slate-200 p-4">
                            <p class="text-xs font-bold uppercase text-slate-500">Tồn kho</p>
                            <p class="mt-2 text-lg font-black <%= part.stock > 5 ? 'text-green-700' : part.stock > 0 ? 'text-amber-600' : 'text-red-600' %>">
                                <%= part.stock > 0 ? `${part.stock} sản phẩm` : 'Hết hàng' %>
                            </p>
                        </div>
                        <div class="rounded-2xl bg-slate-50 border border-slate-200 p-4">
                            <p class="text-xs font-bold uppercase text-slate-500">Mã sản phẩm</p>
                            <p class="mt-2 text-lg font-black text-slate-900">SKU-<%= String(part.id).padStart(4, '0') %></p>
                        </div>
                    </div>

                    <% if (assignedPromotion) { %>
                        <div class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-4 text-sm text-amber-800">
                            Mã áp dụng cho sản phẩm này: <span class="font-black"><%= assignedPromotion.code %></span>.
                            Hãy thêm vào giỏ rồi nhập đúng mã để hệ thống áp ưu đãi theo thiết lập của admin.
                        </div>
                    <% } %>

                    <% if (isCustomer && part.stock > 0) { %>
                        <form action="/shop/cart/add/<%= part.id %>" method="POST" class="flex flex-col sm:flex-row gap-4 mt-auto">
                            <input type="number" name="quantity" min="1" max="<%= part.stock %>" value="1" class="w-full sm:w-32 rounded-2xl border border-slate-200 px-4 py-3 font-bold outline-none focus:border-blue-500">
                            <button type="submit" class="flex-1 rounded-2xl bg-blue-700 px-5 py-3 font-black text-white hover:bg-blue-800 transition">
                                Thêm vào giỏ hàng
                            </button>
                        </form>
                    <% } else if (!authUser) { %>
                        <a href="/auth/login" class="mt-auto inline-flex justify-center rounded-2xl bg-blue-700 px-5 py-3 font-black text-white hover:bg-blue-800 transition">
                            Đăng nhập để mua hàng
                        </a>
                    <% } else { %>
                        <div class="mt-auto rounded-2xl bg-slate-100 px-5 py-4 text-sm font-semibold text-slate-600">
                            Tài khoản quản trị đang xem trước giao diện khách hàng.
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
