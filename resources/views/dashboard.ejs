<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-100 text-slate-900">
  <div class="min-h-screen lg:grid lg:grid-cols-[280px_1fr]">
    <aside class="bg-slate-950 px-6 py-8 text-slate-100">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-blue-300">Admin</p>
        <h1 class="mt-4 text-2xl font-black">NNPTUDM_22DTHE9</h1>
      </div>

      <nav class="mt-10 space-y-2 text-sm">
        <a href="/" class="block rounded-2xl bg-blue-500 px-4 py-3 font-semibold text-white">Dashboard</a>
        <a href="/parts" class="block rounded-2xl px-4 py-3 text-slate-300 hover:bg-slate-900">Phu tung</a>
        <a href="/orders" class="block rounded-2xl px-4 py-3 text-slate-300 hover:bg-slate-900">Don hang</a>
        <a href="/users" class="block rounded-2xl px-4 py-3 text-slate-300 hover:bg-slate-900">Nguoi dung</a>
        <a href="/categories" class="block rounded-2xl px-4 py-3 text-slate-300 hover:bg-slate-900">Danh muc</a>
        <a href="/suppliers" class="block rounded-2xl px-4 py-3 text-slate-300 hover:bg-slate-900">Nha cung cap</a>
        <a href="/promotions" class="block rounded-2xl px-4 py-3 text-slate-300 hover:bg-slate-900">Khuyen mai</a>
        <a href="/shop-preview" class="block rounded-2xl px-4 py-3 text-slate-300 hover:bg-slate-900">Shop preview</a>
      </nav>

      <div class="mt-10 rounded-3xl border border-white/10 bg-white/5 p-5">
        <p class="text-xs uppercase tracking-[0.2em] text-slate-400">Dang nhap boi</p>
        <p class="mt-3 font-semibold"><%= authUser ? authUser.fullName : 'Unknown user' %></p>
        <p class="text-sm text-slate-400"><%= authUser ? authUser.role : '' %></p>
        <form action="/auth/logout" method="POST" class="mt-4">
          <button type="submit" class="w-full rounded-2xl border border-white/15 px-4 py-3 text-sm font-semibold text-white hover:bg-white/10">
            Dang xuat
          </button>
        </form>
      </div>
    </aside>

    <main class="p-6 lg:p-8">
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-sm uppercase tracking-[0.25em] text-slate-500">Tong quan</p>
          <h2 class="mt-2 text-3xl font-black">Dashboard admin du lieu that</h2>
        </div>
        <div class="rounded-2xl bg-white px-5 py-4 shadow-sm">
          <p class="text-sm text-slate-500">Tai khoan dang dung</p>
          <p class="font-semibold"><%= authUser ? authUser.username : '' %></p>
        </div>
      </div>

      <section class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-3xl bg-white p-6 shadow-sm">
          <p class="text-sm text-slate-500">Tong don hang</p>
          <p class="mt-3 text-4xl font-black"><%= stats.totalOrders %></p>
        </div>
        <div class="rounded-3xl bg-white p-6 shadow-sm">
          <p class="text-sm text-slate-500">Tong doanh thu</p>
          <p class="mt-3 text-4xl font-black"><%= stats.totalRevenue.toLocaleString('vi-VN') %> d</p>
        </div>
        <div class="rounded-3xl bg-white p-6 shadow-sm">
          <p class="text-sm text-slate-500">Tong ton kho</p>
          <p class="mt-3 text-4xl font-black"><%= stats.totalStock %></p>
          <p class="mt-2 text-sm text-amber-600">Sap het hang: <%= stats.lowStockParts %> san pham</p>
        </div>
        <div class="rounded-3xl bg-white p-6 shadow-sm">
          <p class="text-sm text-slate-500">So khach hang</p>
          <p class="mt-3 text-4xl font-black"><%= stats.totalCustomers %></p>
        </div>
      </section>

      <section class="mt-8 grid gap-6 xl:grid-cols-[1.2fr_0.8fr]">
        <div class="rounded-3xl bg-white shadow-sm">
          <div class="flex items-center justify-between border-b px-6 py-5">
            <h3 class="text-xl font-bold">Don hang gan day</h3>
            <a href="/orders" class="text-sm font-semibold text-blue-600">Xem tat ca</a>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full text-left text-sm">
              <thead class="bg-slate-50 text-slate-500">
                <tr>
                  <th class="px-6 py-4 font-semibold">Ma don</th>
                  <th class="px-6 py-4 font-semibold">Khach hang</th>
                  <th class="px-6 py-4 font-semibold">Ngay dat</th>
                  <th class="px-6 py-4 font-semibold">Trang thai</th>
                  <th class="px-6 py-4 font-semibold text-right">Tong</th>
                </tr>
              </thead>
              <tbody>
                <% recentOrders.forEach(order => { %>
                  <tr class="border-t">
                    <td class="px-6 py-4 font-semibold text-blue-600"><%= order.id %></td>
                    <td class="px-6 py-4"><%= order.customer %></td>
                    <td class="px-6 py-4 text-slate-500"><%= order.date %></td>
                    <td class="px-6 py-4"><span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold"><%= order.status %></span></td>
                    <td class="px-6 py-4 text-right font-bold"><%= order.total.toLocaleString('vi-VN') %> d</td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="rounded-3xl bg-white shadow-sm">
          <div class="flex items-center justify-between border-b px-6 py-5">
            <h3 class="text-xl font-bold">San pham ban chay</h3>
            <a href="/parts" class="text-sm font-semibold text-blue-600">Xem kho</a>
          </div>
          <div class="space-y-4 p-6">
            <% topProducts.forEach(product => { %>
              <div class="flex items-center justify-between rounded-2xl bg-slate-50 p-4">
                <div class="flex items-center gap-3">
                  <img src="<%= product.image %>" alt="<%= product.name %>" class="h-12 w-12 rounded-2xl object-cover">
                  <div>
                    <p class="font-semibold"><%= product.name %></p>
                    <p class="text-sm text-slate-500"><%= product.category %></p>
                  </div>
                </div>
                <div class="text-right">
                  <p class="font-bold"><%= product.soldCount %></p>
                  <p class="text-xs uppercase tracking-[0.2em] text-slate-400">luot ban</p>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
    </main>
  </div>
</body>
</html>
